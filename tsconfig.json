{
  "compilerOptions": {
    "target": "es5",
    "downlevelIteration": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "types": ["node", "jest"],
    "module": "commonjs",
    "lib": [
      "es2015",
      "dom"
    ],
    "declaration": true,
    "outDir": "./build",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
